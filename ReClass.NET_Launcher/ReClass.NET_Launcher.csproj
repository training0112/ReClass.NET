<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ReClassNET_Launcher</RootNamespace>
    <AssemblyName>ReClass.NET_Launcher</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon>ReClassNet.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppConfig>App.config</AppConfig>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(SolutionDir)bin\Debug\</OutputPath>
    <IntermediateOutputPath>$(SolutionDir)obj\$(Configuration)\any\$(MSBuildProjectName)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants)</DefineConstants>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(SolutionDir)bin\Release\</OutputPath>
    <IntermediateOutputPath>$(SolutionDir)obj\$(Configuration)\any\$(MSBuildProjectName)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReClass.NET\Constants.cs" Link="Constants.cs" />
    <Compile Include="..\ReClass.NET\DataExchange\ReClass\ReClassNetFile.Constants.cs" Link="DataExchange\ReClass\ReClassNetFile.Constants.cs" />
    <Compile Include="..\ReClass.NET\Native\INativeMethods.cs" Link="Native\INativeMethods.cs" />
    <Compile Include="..\ReClass.NET\Native\NativeMethods.cs" Link="Native\NativeMethods.cs" />
    <Compile Include="..\ReClass.NET\Native\NativeMethods.Windows.cs" Link="Native\NativeMethods.Windows.cs" />
    <Compile Include="..\ReClass.NET\Extensions\IntPtrExtensions.cs" Link="Extensions\IntPtrExtensions.cs" />
    <Compile Include="..\ReClass.NET\Util\PathUtil.cs" Link="Util\PathUtil.cs" />
    <Compile Include="..\ReClass.NET\Util\CommandLineArgs.cs" Link="Util\CommandLineArgs.cs" />
    <Compile Include="..\ReClass.NET\Util\WinUtil.cs" Link="Util\WinUtil.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config" />
  </ItemGroup>
</Project>
